{
  "uid": "kubeowl-observability",
  "title": "KubeOwl Observability",
  "tags": ["kubeowl", "observability", "runtime"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Reporting Clusters",
      "datasource": {
        "type": "prometheus",
        "uid": "__DATASOURCE_UID__"
      },
      "targets": [
        {
          "expr": "count(kubeowl_cluster_last_seen_timestamp_seconds)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Events",
      "datasource": {
        "type": "prometheus",
        "uid": "__DATASOURCE_UID__"
      },
      "targets": [
        {
          "expr": "sum(kubeowl_runtime_events_total) or vector(0)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "High Events",
      "datasource": {
        "type": "prometheus",
        "uid": "__DATASOURCE_UID__"
      },
      "targets": [
        {
          "expr": "sum(kubeowl_runtime_events_total{severity=\"high\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Medium Events",
      "datasource": {
        "type": "prometheus",
        "uid": "__DATASOURCE_UID__"
      },
      "targets": [
        {
          "expr": "sum(kubeowl_runtime_events_total{severity=\"medium\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Stored Runtime Events",
      "datasource": {
        "type": "prometheus",
        "uid": "__DATASOURCE_UID__"
      },
      "targets": [
        {
          "expr": "sum by (severity, source) (kubeowl_runtime_events_total)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      }
    }
  ]
}
