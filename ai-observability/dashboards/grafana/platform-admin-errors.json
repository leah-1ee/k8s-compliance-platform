    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "BFF and NGINX Ingress HTTP 5xx requests per second.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(sum(rate(http_requests_total{namespace=~\"$namespace\",pod=~\".*($bff_workload).*\",status=~\"5..\"}[5m])) or vector(0)) + (sum(rate(nginx_ingress_controller_requests{namespace=~\"$namespace\",status=~\"5..\"}[5m])) or vector(0))",
